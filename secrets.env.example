# Mobile Store Reviews — official API credentials (VIEW-ONLY)
# ----------------------------------------------------------------------------
# Copy the relevant lines into the shared OpenClaw secrets file
#   ~/.config/openclaw/secrets.env
# (the same file the metrics MySQL integration reads), OR into a local
# `secrets.env` in this repo for development. NEVER commit real values.
#
# This integration only READS reviews and ratings. It never replies. The
# service account / API key only needs read access to your own app(s).
#
# Prefer FILE PATHS to the key files (kept OUTSIDE the repo). The *_BASE64
# fallbacks exist only for runtimes that cannot read external files — leave
# them blank unless you need them.

# ── Google Play (official Android Publisher API) ─────────────────────────────
GOOGLE_PLAY_ENABLED=true
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/google-play-service-account.json
# Optional base64 fallback (disabled by default — leave blank):
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
# Official Google Play ratings come from the Play Console ratings report in your
# private Cloud Storage bucket (Play Console → Download reports → Statistics shows
# the bucket id, like pubsite_prod_rev_xxxxxxxx). The same service account needs
# read access to it. Leave blank to fall back to the fetched-review average.
GOOGLE_PLAY_REPORTS_BUCKET=
GOOGLE_PLAY_REPORTS_LOOKBACK_MONTHS=3

# Optional token for internal OpenClaw skills/scripts calling the mobile-apps
# report APIs (/api/mobile-apps/reports/sync, /reports/status) without a browser
# session. Send it as "Authorization: Bearer <token>". Blank disables token auth.
MOBILE_APPS_API_TOKEN=

# ── Apple App Store (official App Store Connect API) ─────────────────────────
APPSTORE_CONNECT_ENABLED=true
APPSTORE_CONNECT_ISSUER_ID=replace_me
APPSTORE_CONNECT_KEY_ID=replace_me
APPSTORE_CONNECT_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Optional base64 fallback (disabled by default — leave blank):
APPSTORE_CONNECT_PRIVATE_KEY_BASE64=
APPSTORE_CONNECT_APP_ID=replace_me

# ── Sync tuning ──────────────────────────────────────────────────────────────
MOBILE_REVIEWS_SYNC_MAX_PAGES=10
MOBILE_REVIEWS_SYNC_CONCURRENCY=2
MOBILE_REVIEWS_NEGATIVE_THRESHOLD=3

# ── Review translation (free, no API key) ────────────────────────────────────
# Per-review "Translate to Dutch" uses the free MyMemory public API. No key is
# required. Optionally set a contact email to raise the free daily quota.
MYMEMORY_EMAIL=
